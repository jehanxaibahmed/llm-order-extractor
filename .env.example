# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# "openai", "openrouter" or "ollama"
LLM_PROVIDER=openai
# Any model the provider offers, e.g. gpt-4o-mini (OpenAI) or openai/gpt-4o-mini (OpenRouter)
LLM_MODEL=gpt-4o-mini

# Optional
# LLM_BASE_URL=              # any OpenAI-compatible endpoint; ollama defaults to http://localhost:11434/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0          # "none" to omit it, for models that reject temperature
# LLM_STRUCTURED_OUTPUT=     # default: true for openai, false for openrouter and ollama

# Run locally with Ollama (no API key needed; run `ollama pull qwen2.5:14b-instruct` first):
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b-instruct
# LLM_TIMEOUT_SECONDS=120    # local models are slower than hosted ones
