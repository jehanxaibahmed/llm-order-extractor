# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# "openai" or "openrouter"
LLM_PROVIDER=openai
# Any model the provider offers, e.g. gpt-4o-mini (OpenAI) or openai/gpt-4o-mini (OpenRouter)
LLM_MODEL=gpt-4o-mini

# Optional
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0          # "none" to omit it, for models that reject temperature
# LLM_STRUCTURED_OUTPUT=     # default: true for openai, false for openrouter
